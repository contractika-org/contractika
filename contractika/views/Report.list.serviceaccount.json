{
    "name": "Reports",
    "description": "All reports of a parent Service Account.",
    "order": "date",
    "sort": "desc",
    "limit": 100,
    "header": {
        "actions": {
            "ACTION.CREATE": false
        }
    },
    "actions": [
        {
            "id": "action.release",
            "label": "Release",
            "description": "The report will be released and the service account will be updated. ",
            "controller": "contractika_report_do-release",
            "confirm": true
        }
    ],
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "id",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "created",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "from",
                "value": "date_from",
                "width": "15%",
                "widget": {
                    "sortable": true,
                    "usage": "date"
                }
            },
            {
                "type": "field",
                "label": "to",
                "value": "date",
                "width": "15%",
                "widget": {
                    "sortable": true,
                    "usage": "date"
                }
            },
            {
                "type": "field",
                "value": "creator",
                "width": "20%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "has_non_posted",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "is_empty",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "status",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "Task&Ticket",
                "value": "total_points",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "Credit&Correct.",
                "value": "total_credits",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "balance_old",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "balance_new",
                "width": "15%",
                "sortable": true
            }
        ]
    }
}