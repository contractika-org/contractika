{
    "name": "Service Account Lines",
    "description": "Lines from all Service Accounts.",
    "order": "id",
    "sort": "asc",
    "controller": "contractika_serviceaccountline_collect",
    "header": {
        "actions": {
            "ACTION.CREATE": false
        },
        "selection": {
            "default" : false
        }
    },
    "layout": {
        "items": [
            {
                "type": "field",
                "label": "Id",
                "value": "id",
                "width": "10%"
            },
            {
                "type": "field",
                "label": "Service Account",
                "value": "service_account_id",
                "width": "15%",
                "widget": {
                    "sortable": true
                }
            },
            {
                "type": "field",
                "label": "Customer",
                "value": "customer_id",
                "width": "15%",
                "widget": {
                    "sortable": true
                }
            },
            {
                "type": "field",
                "value": "date",
                "width": "15%",
                "widget": {
                    "sortable": true,
                    "usage": "date"
                }
            },
            {
                "type": "field",
                "value": "start",
                "width": "10%",
                "widget": {
                    "sortable": true,
                    "usage": "time"
                }
            },
            {
                "type": "field",
                "value": "end",
                "width": "10%",
                "widget": {
                    "sortable": true,
                    "usage": "time"
                }
            },
            {
                "type": "field",
                "value": "pause",
                "label": "offset",
                "width": "10%"
            },
            {
                "type": "field",
                "value": "on_site",
                "width": "10%",
                "widget": {
                    "sortable": true
                }
            },
            {
                "type": "field",
                "value": "employee_id",
                "label": "Employee",
                "width": "10%",
                "widget": {
                    "sortable": true
                }
            },
            {
                "type": "field",
                "value": "role_id",
                "label": "Role",
                "width": "10%"
            },
            {
                "type": "field",
                "value": "description",
                "width": "30%"
            },
            {
                "type": "field",
                "value": "is_posted",
                "width": "15%",
                "widget": {
                    "sortable": true,
                    "readonly": true
                }
            },
            {
                "type": "field",
                "value": "postedOnTime",
                "width": "15%",
                "widget": {
                    "sortable": true,
                    "usage": "date",
                    "readonly": true
                }
            },
            {
                "type": "field",
                "value": "taskNumber",
                "width": "15%",
                "widget": {
                    "sortable": true
                }
            },
            {
                "type": "field",
                "value": "taskLink",
                "width": "10%",
                "widget": {
                    "link": "icon"
                }
            },
            {
                "type": "field",
                "value": "ticketNumber",
                "width": "15%",
                "widget": {
                    "sortable": true
                }
            },
            {
                "type": "field",
                "value": "ticketLink",
                "width": "10%",
                "widget": {
                    "link": "icon"
                }
            },
            {
                "type": "field",
                "value": "points",
                "width": "10%",
                "widget": {
                    "sortable": true,
                    "readonly": true
                }
            }
        ]
    }
}