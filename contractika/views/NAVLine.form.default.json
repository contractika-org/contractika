{
    "name": "NAV Line",
    "description": "NAV Invoice Line form.",
    "header": {
        "actions": {
            "ACTION.EDIT": true,
            "ACTION.SAVE": [
                {
                    "id": "SAVE_AND_CLOSE"
                }
            ]
        }
    },
    "actions": [
        {
            "id": "action.reconcile",
            "label": "Reconcile",
            "visible": [["has_error", "=", false], ["status", "=", "pending"]],
            "description": "This will reconcile the entry. A new Service Account Line will be created as a 'credit' line and will be attached to the targeted Service Account (But will not be placed on a report yet.)",
            "controller": "model_transition",
            "params": {
                "entity": "contractika\\NAVLine",
                "transition": "reconcile",
                "ids": []
            },
            "confirm": true
        },
        {
            "id": "action.ignore",
            "label": "Ignore",
            "visible": ["status", "=", "pending"],
            "description": "This will put the entry in the ignored list (trash). This can be undone afterwards if necessary.",
            "controller": "model_transition",
            "params": {
                "entity": "contractika\\NAVLine",
                "transition": "ignore",
                "ids": []
            },
            "confirm": true
        },
        {
            "id": "action.restore",
            "label": "Restore",
            "visible": ["status", "=", "ignored"],
            "description": "This will put back the entry in the list of entries to process (NAV lines).",
            "controller": "model_transition",
            "params": {
                "entity": "contractika\\NAVLine",
                "transition": "restore",
                "ids": []
            },
            "confirm": true
        },
        {
            "id": "action.discard_alerts",
            "label": "Discard alerts",
            "visible": [["has_alert", "=", true], ["status", "=", "pending"]],
            "description": "This will discard any pending alert and refresh the error flag.",
            "controller": "contractika_navline_discard-alerts",
            "confirm": false
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "align": "left",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "status",
                                                "visible": false
                                            },
                                            {
                                                "type": "field",
                                                "label": "Customer NAV",
                                                "value": "extref_customer",
                                                "width": "50%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "label": "Contract Ref",
                                                "value": "extref_description2",
                                                "width": "50%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "label": "Customer",
                                                "value": "customer_id",
                                                "width": "50%",
                                                "widget": {
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.CREATE": false
                                                        }
                                                    }
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "label": "Service Account",
                                                "value": "service_account_id",
                                                "width": "50%",
                                                "widget": {
                                                    "domain": [["customer_id", "=", "object.customer_id"], ["is_active", "=", true]],
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.CREATE": false
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "label": "Unit Price",
                                                "value": "extref_unit_price",
                                                "width": "33%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "label": "Quantity",
                                                "value": "extref_quantity",
                                                "width": "33%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "label": "Amount",
                                                "value": "extref_amount",
                                                "width": "33%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "label": "Unit of Measure",
                                                "value": "extref_uom_code",
                                                "width": "33%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "label": "Points",
                                                "value": "points",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "date",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "label",
                                                "value": "",
                                                "width": "50%",
                                                "visible": [[["has_error", "=", true]],[["has_alert", "=", true]]]
                                            },
                                            {
                                                "type": "field",
                                                "label": "Has error(s)",
                                                "value": "has_error",
                                                "width": "25%",
                                                "readonly": true,
                                                "visible": ["has_error", "=", true]
                                            },
                                            {
                                                "type": "field",
                                                "label": "Has alert(s)",
                                                "value": "has_alert",
                                                "width": "25%",
                                                "readonly": true,
                                                "visible": ["has_alert", "=", true]
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.main",
                        "label": "Details",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "align": "left",
                                        "items": [
                                            {
                                                "type": "field",
                                                "label": "Document No",
                                                "value": "extref_document_no",
                                                "width": "50%"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "align": "left",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "description",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "reconciliation_log",
                                                "width": "50%",
                                                "readonly": true
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "section.errors",
                        "label": "Errors & Alerts",
                        "visible": ["has_error", "=", true],
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "align": "left",
                                        "items": [
                                            {
                                                "type": "label",
                                                "value": "Errors",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "label": "Customer",
                                                "value": "has_error_customer",
                                                "width": "50%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "label": "Service Account",
                                                "value": "has_error_service_account",
                                                "width": "50%",
                                                "readonly": true
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "align": "left",
                                        "items": [
                                            {
                                                "type": "label",
                                                "value": "Alerts",
                                                "width": "100%"
                                            },
                                            {
                                                "type": "field",
                                                "label": "Unit of Measure",
                                                "value": "has_alert_uom",
                                                "width": "50%",
                                                "readonly": true
                                            },
                                            {
                                                "type": "field",
                                                "label": "Unit Price",
                                                "value": "has_alert_unit_price",
                                                "width": "50%",
                                                "readonly": true
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}