{
    "name": "Contact",
    "description": "Basic form for displaying a Contact.",
    "header": {
        "actions": {
            "ACTION.EDIT": false
        }
    },
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "75%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "name",
                                                "width": "100%",
                                                "widget": {
                                                    "heading": true,
                                                    "readonly": true
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "id": "section.customer_details",
                        "label": "Details",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "firstname",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "lastname",
                                                "visible": false
                                            },
                                            {
                                                "type": "field",
                                                "label": "AT ID",
                                                "value": "extref_at_id",
                                                "width": "50%",
                                                "visible": false
                                            },
                                            {
                                                "type": "field",
                                                "value": "email",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "language",
                                                "width": "25%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}