{
    "name": "Customers",
    "description": "This view is intended for displaying basic listing of existing Customers.",
    "domain": ["relationship", "=", "customer"],
    "order": "name",
    "sort": "asc",
    "header": {
        "actions": {
            "ACTION.CREATE": false
        },
        "selection": {
            "default": false,
            "actions" : [
                {
                    "id": "header.selection.actions.bulk_reports",
                    "label": "Generate Reports",
                    "icon": "edit_note",
                    "controller": "contractika_sale_customer_bulk-reports"
                }
            ]
        }
    },
    "layout": {
        "items": [
            {
                "type": "field",
                "value": "id",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "name",
                "width": "25%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "Active",
                "value": "is_active",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "Has SA",
                "value": "has_sa",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "VAT",
                "value": "vat_number",
                "width": "20%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "companyType",
                "visible": false,
                "sortable": true
            },
            {
                "type": "field",
                "label": "AT id",
                "value": "extref_at_id",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "NAV id",
                "value": "extref_nav_id",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "Lang",
                "value": "lang_id",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "discount",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "service_price",
                "width": "10%",
                "sortable": true
            },
            {
                "type": "field",
                "value": "target_margin",
                "width": "15%",
                "sortable": true
            },
            {
                "type": "field",
                "label": "TS Report frequency",
                "value": "f_reporting",
                "visible": false
            }
        ]
    }
}