    "header": {
        "actions": {
            "ACTION.CREATE": false
        },
        "selection": {
            "default" : false,
            "actions" : [
                {
                    "id": "header.selection.actions.bulk_restore",
                    "label": "Restore",
                    "icon": "",
                    "controller": "contractika_navline_bulk-restore"
                }
            ]
        }
    },
    "layout": {
