{
    "name": "Service Acccount",
    "description": "Service Account form.",
    "header": {
        "actions": {
            "ACTION.EDIT": false
        }
    },
    "actions": [
        {
            "id": "action.report",
            "label": "Create report",
            "description": "A draft report will be created and the pending lines of the service account will be added to it. If a previous draft report exists, it will be overwritten.",
            "controller": "contractika_serviceaccount_do-report",
            "confirm": true
        }
    ],
    "layout": {
        "groups": [
            {
                "sections": [
                    {
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "align": "left",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "name",
                                                "width": "33%",
                                                "widget": {
                                                    "readonly": true
                                                }
                                            },
                                            {
                                                "type": "field",
                                                "label": "AT Contract ID",
                                                "value": "contractId",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "label": "Reporting Start",
                                                "value": "reporting_from",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "label": "Customer",
                                                "value": "customer_id",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "contractLink",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "status",
                                                "visible": false
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "is_active",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "balance_current",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "label",
                                                "value": "",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "label": "Last Line",
                                                "value": "last_line_id",
                                                "width": "66%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "sections": [
                    {
                        "label":"Details",
                        "id": "section.details",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "align": "left",
                                        "items": [
                                            {
                                                "type": "field",
                                                "label": "Service Account Category",
                                                "value": "sa_category_id",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "label",
                                                "value": "",
                                                "width": "50%"
                                            },
                                            {
                                                "type": "field",
                                                "label": "Service Account Type",
                                                "value": "sa_type_id",
                                                "width": "50%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "align": "left",
                                        "items": [
                                            {
                                                "type": "field",
                                                "label": "Bonus",
                                                "value": "is_bonus",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "label",
                                                "value": "",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "label": "Reporting",
                                                "value": "m_reporting",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "label": "CutOff",
                                                "value": "is_invoiceable",
                                                "width": "33%"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "columns": [
                                    {
                                        "width": "50%",
                                        "align": "left",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "description",
                                                "width": "100%"
                                            }
                                        ]
                                    },
                                    {
                                        "width": "50%",
                                        "align": "left",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "renew_auto",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "renew_floor",
                                                "width": "33%"
                                            },
                                            {
                                                "type": "field",
                                                "value": "renew_amount",
                                                "width": "33%"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "label":"Ticket & Task Lines",
                        "id": "section.lines_tickets",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "sa_lines_tt_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.CREATE": false
                                                        }
                                                    },
                                                    "actions": false,
                                                    "view": "list.ticket",
                                                    "domain": ["is_locked", "=", false]
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "label":"Credits & Corrections",
                        "id": "section.lines_credits",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "sa_lines_cc_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.credit",
                                                    "mode": "edit",
                                                    "header": {
                                                        "selection": {
                                                            "default": false
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "label":"Reports",
                        "id": "section.reports",
                        "rows": [
                            {
                                "columns": [
                                    {
                                        "width": "100%",
                                        "items": [
                                            {
                                                "type": "field",
                                                "value": "reports_ids",
                                                "width": "100%",
                                                "widget": {
                                                    "view": "list.serviceaccount",
                                                    "header": {
                                                        "actions": {
                                                            "ACTION.CREATE": false
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}