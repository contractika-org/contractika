{
    "document_links": {
        "bonus_pdf": "calcLink",
        "bonus_pdf_data": "calcPdfData",
        "cutoff_xls": "calcLink",
        "report_pdf": "calcLink",
        "report_pdf_data": "calcPdfData"
    },
    "models": {
        "Absence": {
            "fields": {
                "employee_id": {
                    "description": "The employee the absence relates to.",
                    "foreign_object": "contractika\\hr\\employee\\Employee",
                    "ondelete": "cascade",
                    "required": true,
                    "type": "many2one"
                },
                "extref_at_id": {
                    "description": "AutoTask appointment identifier (int).",
                    "type": "integer"
                },
                "extref_sd_id": {
                    "description": "SDworx absence identifier (string: [0-9]{2}-[0-9]{20}).",
                    "type": "string",
                    "unique": true
                },
                "layer": {
                    "default": "absences",
                    "selection": [
                        "absences",
                        "planning"
                    ],
                    "type": "string"
                },
                "status": {
                    "default": "requested",
                    "selection": [
                        "requested",
                        "planned",
                        "approved",
                        "refused",
                        "requesteddeleted",
                        "approveddeleted"
                    ],
                    "type": "string"
                }
            }
        },
        "BonusReport": {
            "actions": {
                "init": {
                    "description": "Provide conditions to check if a collection of Reports is releasable for a given user.",
                    "function": "doInit",
                    "policies": []
                }
            },
            "workflow": {
                "pending": {
                    "transitions": {
                        "release": {
                            "description": "Release the Report.",
                            "policies": [
                                "releasable"
                            ],
                            "status": "released"
                        }
                    }
                },
                "released": {
                    "columns": [],
                    "readonly": true,
                    "transitions": []
                }
            }
        },
        "Customer": {
            "fields": {
                "extref_at_id": {
                    "description": "Code used by PSA software (AutoTask) for the Customer.",
                    "type": "integer",
                    "unique": true
                },
                "extref_nav_id": {
                    "description": "Code used by Accounting software (Navision) as Customer identifier.",
                    "type": "string"
                },
                "has_sa": {
                    "description": "Flag marking the customer has having at least one active service account (contract).",
                    "function": "calcHasSa",
                    "instant": true,
                    "result_type": "boolean",
                    "store": true,
                    "type": "computed"
                },
                "partner_identity_id": {
                    "description": "The targeted identity (the partner).",
                    "foreign_object": "contractika\\identity\\Identity",
                    "onupdate": "onupdatePartnerIdentityId",
                    "required": true,
                    "type": "many2one"
                },
                "service_price": {
                    "description": "Billable price per quarter of hour as agreed by Contract.",
                    "onupdate": "onupdateServicePrice",
                    "type": "float",
                    "usage": "amount/money:4"
                }
            },
            "table": "sale_customer_customer"
        },
        "CutOffReport": {
            "actions": {
                "init": {
                    "description": "Generates the lines of the Report.",
                    "function": "doInit",
                    "policies": []
                }
            },
            "workflow": {
                "pending": {
                    "transitions": {
                        "release": {
                            "description": "Releases the Report.",
                            "domain": [
                                "has_pending_report",
                                "=",
                                false
                            ],
                            "help": "The transition will be allowed only if the report is releasable. This transition cannot be undone.",
                            "policies": [
                                "releasable"
                            ],
                            "status": "released"
                        }
                    }
                },
                "released": {
                    "transitions": []
                }
            }
        },
        "Employee": {
            "fields": {
                "display_name": {
                    "function": "calcDisplayName",
                    "result_type": "string",
                    "store": false,
                    "type": "computed"
                },
                "extref_at_id": {
                    "description": "Code used by PSA software for the identity (AutoTask Resource).",
                    "function": "calcExtRefAtId",
                    "result_type": "integer",
                    "store": true,
                    "type": "computed"
                },
                "extref_sd_id": {
                    "description": "Code used by employment agency partner for the employee (SDworx Employee).",
                    "type": "string",
                    "unique": true
                },
                "partner_identity_id": {
                    "description": "The targeted identity.",
                    "foreign_object": "contractika\\identity\\Identity",
                    "onupdate": "onupdatePartnerIdentityId",
                    "required": true,
                    "type": "many2one"
                }
            },
            "table": "identity_partner"
        },
        "NAVLine": {
            "fields": {
                "customer_id": {
                    "description": "Customer the line relates to (depending on service account).",
                    "foreign_object": "contractika\\sale\\customer\\Customer",
                    "function": "calcCustomerId",
                    "help": "The customer id retrieved by mapping the received NAV customer (`extref_customer`) with the field `extref_nav_id` in Customer objects.",
                    "onupdate": "onupdateCustomerId",
                    "result_type": "many2one",
                    "store": true,
                    "type": "computed"
                },
                "has_alert": {
                    "dependencies": [
                        "has_error"
                    ],
                    "description": "Line has one or more warnings.",
                    "function": "calcHasAlert",
                    "result_type": "boolean",
                    "store": true,
                    "type": "computed"
                },
                "has_error": {
                    "description": "Flag marking a line as faulty.",
                    "function": "calcHasError",
                    "result_type": "boolean",
                    "store": true,
                    "type": "computed"
                },
                "sa_line_id": {
                    "description": "Service Account line the NAV line has been reconciled with.",
                    "foreign_object": "contractika\\SALine",
                    "type": "many2one",
                    "visible": [
                        "status",
                        "=",
                        "reconciled"
                    ]
                },
                "service_account_id": {
                    "description": "The service account the line belongs to.",
                    "foreign_object": "contractika\\ServiceAccount",
                    "function": "calcServiceAccountId",
                    "onupdate": "onupdateServiceAccountId",
                    "result_type": "many2one",
                    "store": true,
                    "type": "computed"
                },
                "status": {
                    "default": "pending",
                    "description": "Status of the line.",
                    "help": "The status impacts the available actions along with the filtering within views. Possible status are degined in `getWorkflow()` method.",
                    "selection": [
                        "pending",
                        "reconciled",
                        "ignored"
                    ],
                    "type": "string"
                }
            },
            "table": "contractika_navline",
            "workflow": {
                "ignored": {
                    "transitions": {
                        "restore": {
                            "description": "Update the line status to 'pending'. This transition is meant to be called manually.",
                            "status": "pending"
                        }
                    }
                },
                "pending": {
                    "transitions": {
                        "ignore": {
                            "description": "Update the line status to `ignored`. This transition is meant to be called manually.",
                            "status": "ignored"
                        },
                        "reconcile": {
                            "description": "Update the line status to `reconciled`.",
                            "domain": [
                                [
                                    "service_account_id",
                                    ">",
                                    0
                                ],
                                [
                                    "customer_id",
                                    ">",
                                    0
                                ],
                                [
                                    "has_error",
                                    "=",
                                    false
                                ]
                            ],
                            "help": "The transition will be allowed only if there are no pending errors.",
                            "onafter": "doReconcile",
                            "status": "reconciled"
                        }
                    }
                },
                "reconciled": {
                    "transitions": []
                }
            }
        },
        "Report": {
            "fields": {
                "balance_new": {
                    "description": "New balance of the related Service Account.",
                    "function": "calcBalanceNew",
                    "help": "Tells the balance after invoicing the lines assigned to the report.\r\n                                        This value is automatically updated upon status change (when report is released).\r\n                                        For pending reports, this value might differ from the relating ServiceAccount's balance.",
                    "result_type": "float",
                    "store": true,
                    "type": "computed"
                },
                "balance_old": {
                    "description": "Previous balance of the related Service Account (from last previous report).",
                    "function": "calcBalanceOld",
                    "help": "Tells the balance after invoicing the lines assigned to the report.\r\n                                        For released reports, this value might differ from the relating ServiceAccount's balance.",
                    "instant": true,
                    "result_type": "float",
                    "store": true,
                    "type": "computed"
                },
                "has_non_posted": {
                    "description": "Report contains non posted time entries (cannot be released).",
                    "function": "calcHasNonPosted",
                    "result_type": "boolean",
                    "store": true,
                    "type": "computed"
                },
                "link": {
                    "description": "URL for generating the PDF version of the report.",
                    "function": "calcLink",
                    "readonly": true,
                    "result_type": "string",
                    "type": "computed",
                    "usage": "uri/url"
                },
                "pdf_data": {
                    "description": "Raw data of of the generated PDF (does not change over time).",
                    "function": "calcPdfData",
                    "result_type": "binary",
                    "store": true,
                    "type": "computed"
                },
                "status": {
                    "default": "pending",
                    "description": "Status of the report.",
                    "onupdate": "onupdateStatus",
                    "selection": [
                        "pending",
                        "released",
                        "archived",
                        "sent"
                    ],
                    "type": "string"
                },
                "total_credits": {
                    "description": "Sum of all CC lines.",
                    "function": "calcTotalCredits",
                    "result_type": "float",
                    "store": true,
                    "type": "computed"
                },
                "total_points": {
                    "description": "Sum of all TT lines (negative value).",
                    "function": "calcTotalPoints",
                    "result_type": "float",
                    "store": true,
                    "type": "computed"
                }
            }
        },
        "SALine": {
            "fields": {
                "duration": {
                    "description": "Computed duration: end time minus start time minus pause time.",
                    "function": "calcDuration",
                    "result_type": "time",
                    "store": true,
                    "type": "computed"
                },
                "is_async": {
                    "default": false,
                    "description": "Flag raised if  the line is locked in CT but has been modified in AT.",
                    "help": "Modifying a locked entry is supposed to be forbidden. This flag is used to prevent recurring error messages.",
                    "type": "boolean"
                },
                "is_locked": {
                    "default": false,
                    "description": "Marks the line as locked/invoiced (equivalent to has_report with a report in `released` status).",
                    "onupdate": "onupdateIsLocked",
                    "type": "boolean"
                },
                "is_orphan": {
                    "default": false,
                    "description": "Flag raised if the line is present in CT but has been deleted in AT.",
                    "help": "Deleting a posted entry is supposed to be forbidden. This flag is used to prevent recurring error messages.",
                    "type": "boolean"
                },
                "pause_time": {
                    "description": "Absolute time based on offset (to subtract or add to the duration).",
                    "function": "calcPauseTime",
                    "result_type": "time",
                    "store": true,
                    "type": "computed"
                },
                "points": {
                    "description": "Number of points the line corresponds to (can be computed or set manually).",
                    "function": "calcPoints",
                    "help": "Points count is always a positive number. Points from Ticket and Task lines are used to decrement the related Report balance, and Credit and Correction lines are used to increment it.",
                    "onupdate": "onupdatePoints",
                    "result_type": "float",
                    "store": true,
                    "type": "computed"
                },
                "report_id": {
                    "description": "Report to which the line is assigned, if any.",
                    "foreign_object": "contractika\\Report",
                    "ondelete": "null",
                    "onupdate": "onupdateReportId",
                    "type": "many2one",
                    "visible": [
                        "has_report",
                        "=",
                        true
                    ]
                },
                "service_account_id": {
                    "description": "The service account the line belongs to.",
                    "foreign_object": "contractika\\ServiceAccount",
                    "onupdate": "onupdateServiceAccountId",
                    "type": "many2one"
                },
                "travel_time": {
                    "description": "Computed travel duration: based on settings and customer.",
                    "function": "calcTravelTime",
                    "result_type": "time",
                    "store": true,
                    "type": "computed"
                }
            }
        },
        "ServiceAccount": {
            "fields": {
                "balance_current": {
                    "description": "The amount of remaining points in the account according to all existing lines.",
                    "function": "calcBalanceCurrent",
                    "result_type": "float",
                    "store": true,
                    "type": "computed"
                },
                "contractId": {
                    "dependencies": [
                        "extref_at_id"
                    ],
                    "description": "External reference. Code used by AutoTask PSA software for the contract.",
                    "type": "integer",
                    "unique": true
                },
                "has_balance_changed": {
                    "default": false,
                    "description": "Mark the balance as changed (used for sync with AutoTask).",
                    "type": "boolean"
                },
                "renew_auto": {
                    "default": false,
                    "description": "Automatic Renewal of ServicePackage.",
                    "type": "boolean"
                },
                "renew_floor": {
                    "default": 0,
                    "description": "Floor in # for triggering renewal.",
                    "type": "float",
                    "visible": [
                        "renew_auto",
                        "=",
                        true
                    ]
                },
                "status": {
                    "default": "signed",
                    "description": "Status of the contract.",
                    "selection": [
                        "signed"
                    ],
                    "type": "string"
                }
            },
            "table": "contractika_serviceaccount"
        }
    }
}
