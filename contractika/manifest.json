{
    "name": "contractika",
    "author": "Yesbabylon SA",
    "version": "1.0",
    "depends_on": [
        "core",
        "sale",
        "hr",
        "identity"
    ],
    "requires": {
        "swiftmailer/swiftmailer": "^6.2",
        "phpoffice/phpspreadsheet": "^1.4",
        "dompdf/dompdf": "~3.0.0",
        "twig/twig": "^2.0",
        "twig/intl-extra": "^3.3",
        "smhg/sepa-qr-data": "^1.1",
        "endroid/qr-code": "^4.3"
    },
    "apps": [
        "app", "apps", "auth", "contractika",
        {
            "id": "settings",
            "name": "Settings",
            "extends": "app",
            "description": "Settings & Config params",
            "icon": "settings",
            "color": "#ff9741",
            "access": {
                "groups": [
                    "admins"
                ]
            },
            "params": {
                "menus": {
                    "left": "settings.left"
                }
            },
            "show_in_apps": true
        }
    ]
}
